{
  "name": "emb3r",
  "version": "1.34.0",
  "description": "Local LLM desktop app powered by node-llama-cpp",
  "author": "Ziyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FRENCHIIIFRIES/emb3r-ai.git"
  },
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test-ai": "node test-ai.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@huggingface/transformers": "^3.8.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "kokoro-js": "^1.2.1",
    "mammoth": "^1.12.0",
    "node-llama-cpp": "^3.19.0",
    "pdfjs-dist": "^6.2.108"
  },
  "allowScripts": {
    "node-llama-cpp@3.19.0": true,
    "electron-winstaller@5.4.0": true,
    "@google/genai@2.12.0": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.5": true
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.frenchiiifries.emb3r",
    "productName": "emb3r",
    "publish": {
      "provider": "github",
      "owner": "FRENCHIIIFRIES",
      "repo": "emb3r-ai"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**",
      "**/node_modules/pdfjs-dist/standard_fonts/**",
      "**/node_modules/onnxruntime-node/bin/**"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.cjs",
      "src/**/*",
      "build/icon.png",
      "!models/**",
      "!**/node_modules/@node-llama-cpp/win-arm64/**",
      "!**/node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!**/node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!**/node_modules/pdfjs-dist/web/**",
      "!**/node_modules/pdfjs-dist/image_decoders/**",
      "!**/node_modules/pdfjs-dist/types/**",
      "!**/node_modules/pdfjs-dist/build/**",
      "!**/node_modules/pdfjs-dist/**/*.map",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/sharp/**",
      "!**/node_modules/@img/**",
      "!**/node_modules/kokoro-js/voices/*.bin",
      "**/node_modules/kokoro-js/voices/af_heart.bin"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**"
      ]
    },
    "beforePack": "./scripts/fetch-voice.cjs",
    "afterPack": "./scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "build/voice",
        "to": "voice",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
